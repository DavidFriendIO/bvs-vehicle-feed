# Copy these three lines into a file called .env (same folder as run-crawl.bat) and replace the
# bits after the = signs. See WINDOWS-SETUP.md for exactly where to find each value.
# No quotes, no spaces around the = sign.

CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# Optional: emails david@profitablesites.com if something fails. Leave blank to skip.
RESEND_API_KEY=

# Optional: only if Chrome is installed somewhere unusual.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
